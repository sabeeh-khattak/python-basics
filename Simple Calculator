#Simple Calculator:
num1 = float(input("Enter the first number:"))
num2 = float(input("Enter the second number:"))

print("\n select an operator:")
print("1. Add")
print("2. Subtract")
print("3. Multiply")
print("4. Divide")

operator = input("select your operator from (1-4):")

if operator == "1":
   result = num1 + num2
   print("Result:", result)

elif operator == "2":
    result = num1 - num2
    print("Result:", result)
    
elif operator == "3":
     result = num1 * num2
     print("Result:", result)
     
elif operator == "4":
    if num2 == 0:
        print("Error: Cannot divide by zero.")
    else:
        result = num1 / num2
        print("Result:", result)

else:
    print("Invalid choise")
     

